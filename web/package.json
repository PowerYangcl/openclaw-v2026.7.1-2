{
  "name": "openclaw-control-ui-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenClaw Web Control UI — Vue 3 + Vite + Pinia + Element Plus + Tailwind 4. Replaces the legacy Lit-based ui/.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:no-typecheck": "vite build",
    "build:pre": "vue-tsc --noEmit && vite build --mode pre",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "npm run test:unit:session && npm run test:unit:media && npm run test:unit:sidebar",
    "test:unit:session": "esbuild tests/sessionListSelection.test.ts --bundle --format=esm --platform=node --tsconfig=tsconfig.json --outfile=node_modules/.cache/sessionListSelection.test.mjs && node node_modules/.cache/sessionListSelection.test.mjs",
    "test:unit:media": "esbuild tests/mediaAndAvatarUrls.test.ts --bundle --format=esm --platform=node --tsconfig=tsconfig.json --outfile=node_modules/.cache/mediaAndAvatarUrls.test.mjs && node node_modules/.cache/mediaAndAvatarUrls.test.mjs",
    "test:unit:sidebar": "esbuild tests/sidebarSnapshot.test.ts --bundle --format=esm --platform=node --tsconfig=tsconfig.json --outfile=node_modules/.cache/sidebarSnapshot.test.mjs && node node_modules/.cache/sidebarSnapshot.test.mjs",
    "test:e2e": "node tests/smoke/media-avatar.e2e.mjs",
    "test:e2e:fallback": "node tests/smoke/avatar-fallback.e2e.mjs",
    "test:e2e:menu": "node tests/smoke/first-paint-menu.e2e.mjs",
    "test:e2e:boot": "node tests/smoke/gateway-web-boot.mjs",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@noble/ed25519": "3.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.2.6",
    "element-plus": "^2.14.5",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.24.0",
    "playwright": "^1.49.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
